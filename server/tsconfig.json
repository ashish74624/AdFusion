{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2020",
    "module": "ESNext",

    /* Folder layout */
    "rootDir": "./",          // <‑‑ source files live in the root
    "outDir": "./dist",       // <‑‑ compiled JS ends up here

    /* Module resolution */
    "moduleResolution": "node",
    "esModuleInterop": true,  // keeps CommonJS interop easy

    /* Type‑safety */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts"]      /* compile only the entry file (and its imports) */
}
